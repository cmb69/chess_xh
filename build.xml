<?xml version="1.0" encoding="UTF-8"?>

<project name="Chess" default="default">

  <fileset id="attack-tests" dir="tests/attack">
    <include name="*Test.php"/>
  </fileset>

  <target name="sniff" description="checks adherence to coding standards">
    <exec executable="phpcs" passthru="true" checkreturn="true">
      <arg value="--standard=PEAR"/>
      <arg line="--runtime-set ignore_warnings_on_exit true"/>
      <arg file="admin.php"/>
      <arg file="index.php"/>
      <arg file="classes"/>
    </exec>
  </target>

  <target name="stan" description="runs static analyzer">
    <exec executable="phpstan" passthru="true" checkreturn="true"/>
  </target>

  <target name="test" description="runs all tests">
    <exec executable="phpunit" passthru="true" checkreturn="true"/>
  </target>

  <target name="check" description="runs all checks" depends="sniff,stan,test"/>

  <target name="attack-tests">
    <fail unless="env.CMSIMPLEDIR" message="CMSIMPLEDIR undefined!"/>
    <phpunit haltonerror="true" haltonfailure="true">
      <formatter type="plain" usefile="false"/>
      <batchtest>
        <fileset refid="attack-tests"/>
      </batchtest>
    </phpunit>
  </target>

  <target name="coverage" description="generates coverage report">
    <exec executable="phpunit" passthru="true" checkreturn="true">
      <arg value="--coverage-html"/>
      <arg file="coverage"/>
    </exec>
  </target>

  <target name="build">
    <fail unless="version" message="version is not defined!"/>
    <svnexport revision="" repositoryurl="." todir="export"/>
    <jsMin targetDir="dist" suffix="" failOnError="false">
      <fileset dir="export">
        <include name="chess.js"/>
      </fileset>
    </jsMin>
    <move todir="dist">
      <fileset dir="export">
        <exclude name="tests/**"/>
        <exclude name="chess.js"/>
        <exclude name="chess.komodoproject"/>
        <exclude name="build.xml"/>
        <exclude name="composer.*"/>
        <exclude name="coverage.xml"/>
        <exclude name="phpcompatinfo.xml"/>
        <exclude name="TODO"/>
      </fileset>
    </move>
    <delete dir="export"/>
    <!--<copy file="dist/config/config.php" tofile="dist/config/defaultconfig.php"/>-->
    <copy file="dist/languages/en.php" tofile="dist/languages/default.php"/>
    <zip destfile="Chess_XH-${version}.zip" basedir="dist" prefix="chess/"/>
    <delete dir="dist"/>
  </target>

</project>
